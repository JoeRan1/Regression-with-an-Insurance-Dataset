ples_leaf', 10, 100\n","        ),\n","        'RMSLE_model__l2_regularization': trial.suggest_float(\n","            'l2_regularization', 1e-4, 10.0, log=True\n","        ),\n","        'RMSLE_model__max_bins': trial.suggest_int(\n","            'max_bins', 64, 255\n","        ),\n","    }\n","\n","    model = hist_gradient_boosting_pipeline.set_params(**params)\n","\n","    scores = cross_val_score(\n","        model,\n","        X,\n","        y,\n","        cv=cv,\n","        scoring='neg_root_mean_squared_log_error',\n","        n_jobs=1\n","    )\n","\n","    return -scores.mean()\n","\n","study_hist = optuna.create_study(direction='minimize')\n","\n","study_hist.optimize(objective, n_trials=30)\n","\n","print('Best RMSLE:', study_hist.best_value)\n","print('Best parameters:', study_hist.best_params)\n","\n","\n","# Best RMSLE: 1.1337771884689802\n","# Best parameters: {'max_iter': 200, 'learning_rate': 0.055314185489516894, 'max_leaf_nodes': 56, 'max_depth': 12, 'min_samples_leaf': 86, 'l2_regularization': 4.342539654062986, 'max_bins': 221}"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"zdmvLodni4eq","executionInfo":{"status":"ok","timestamp":1792004592527,"user_tz":240,"elapsed":2,"user":{"displayName":"Javlon Nizamiddinov","userId":"15677173226188840130"}},"outputId":"5bbabd4f-71b9-4962-f569-8fa80d7b30b0"},"execution_count":20,"outputs":[{"metadata":{"tags":null},"name":"stderr","output_type":"stream","text":["[I 2026-10-14 17:54:27,741] A new study created in memory with name: no-name-0eeb0e6c-fa9b-45c0-877c-e83b6d09708d\n","[I 2026-10-14 17:57:03,327] Trial 0 finished with value: 1.1431542966697226 and parameters: {'max_iter': 400, 'learning_rate': 0.1324730443807683, 'max_leaf_nodes': 46, 'max_depth': 4, 'min_samples_leaf': 16, 'l2_regularization': 3.595036369995458, 'max_bins': 250}. Best is trial 0 with value: 1.1431542966697226.\n","[I 2026-10-14 17:59:20,986] Trial 1 finished with value: 1.138944003602166 and parameters: {'max_it