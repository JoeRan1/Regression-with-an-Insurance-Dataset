,{"cell_type":"code","source":["\n","import numpy as np\n","import pandas as pd\n","\n","from sklearn.base import BaseEstimator, TransformerMixin\n","from sklearn.pipeline import Pipeline\n","from sklearn.preprocessing import OneHotEncoder, StandardScaler\n","\n","\n","class CustomPreprocessor(BaseEstimator, TransformerMixin):\n","\n","    def fit(self, X, y=None):\n","        X = X.copy()\n","\n","        # Learn imputation values from training data only\n","        self.imputation_values_ = {\n","            'Credit Score': X['Credit Score'].mean(),\n","            'Health Score': X['Health Score'].median(),\n","            'Annual Income': X['Annual Income'].median(),\n","            'Age': X['Age'].median()\n","        }\n","\n","        # Fit OneHotEncoders on training data\n","        self.encoders_ = {}\n","\n","        for col in ['Marital Status', 'Occupation', 'Customer Feedback']:\n","            encoder = OneHotEncoder(\n","                handle_unknown='ignore',\n","                drop=['Unknown'],\n","                sparse_output=False\n","            )\n","\n","            # Match the requested missing-value handling\n","            if col in ['Occupation', 'Customer Feedback']:\n","                X[col] = X[col].fillna('Unknown')\n","            else:\n","                X[col] = X[col].fillna('Unknown')\n","\n","            encoder.fit(X[[col]])\n","            self.encoders_[col] = encoder\n","\n","        # Fit the scaler using processed training data\n","        X_processed = self._transform(X, fit_scaler=True)\n","\n","        return self\n","\n","    def _transform(self, X, fit_scaler=False):\n","        X = X.copy()\n","\n","        # 1. Missing-value indicators and imputation\n","\n","        X['Previous Claims Missing'] = (\n","            X['Previous Claims'].isna().astype(int)\n","        )\n","        X['Previous Claims'] = X['Previous Claims'].fillna(0.0)\n","\n","        X['Occupation Missing'] = (\n","            X['Occupation'].isna().astype(int)\n","        )\n","        X['Occupation'] = X['Occupation'].fillna('Unknown')\n","\n","        X['Credit Score'] = X['Credit Score'].fillna(\n","            self.imputation_values_['Credit Score']\n","        )\n","\n","        X['Number of Dependents Missing'] = (\n","            X['Number of Dependents'].isna().astype(int)\n","        )\n","        X['Number of Dependents'] = (\n","            X['Number of Dependents'].fillna(0.0)\n","        )\n","\n","        X['Customer Feedback Missing'] = (\n","            X['Customer Feedback'].isna().astype(int)\n","        )\n","        X['Customer Feedback'] = (\n","            X['Customer Feedback'].fillna('Unknown')\n","        )\n","\n","        X['Health Score'] = X['Health Score'].fillna(\n","            self.imputation_values_['Health Score']\n","        )\n","\n","        X['Annual Income Missing'] = (\n","            X['Annual Income'].isna().astype(int)\n","        )\n","        X['Annual Income'] = X['Annual Income'].fillna(\n","            self.imputation_values_['Annual Income']\n","        )\n","\n","        X['Age Missing'] = X['Age'].isna().astype(int)\n","        X['Age'] = X['Age'].fillna(\n","            self.imputation_values_['Age']\n","        )\n","\n","        X['Marital Status'] = X['Marital Status'].fillna('Unknown')\n","        X['Vehicle Age'] = X['Vehicle Age'].fillna(0.0)\n","        X['Insurance Duration'] = X['Insurance Duration'].fillna(0.0)\n","\n","        # 2. Binary and ordinal mappings\n","\n","        X['Gender'] = X['Gender'].map({\n","            'Female': 0,\n","            'Male': 1\n","        })\n","\n","        X['Education Level'] = X['Education Level'].map({\n","            'High School': 0,\n","            \"Bachelor's\": 1,\n","            \"Master's\": 2,\n","            'PhD': 3\n","        })\n","\n","        X['Location'] = X['Location'].map({\n","            'Rural': 0,\n","            'Suburban': 1,\n","            'Urban': 2\n","        })\n","\n","        X['Policy Type'] = X['Policy Type'].map({\n","            'Basic': 0,\n","            'Comprehensive': 1,\n","            'Premium': 2\n","        })\n","\n","        X['Smoking Status'] = X['Smoking Status'].map({\n","            'No': 0,\n","            'Yes': 1\n","        })\n","\n","        X['Exercise Frequency'] = X['Exercise Frequency'].map({\n","            'Rarely': 0,\n","            'Monthly': 1,\n","            'Weekly': 2,\n","            'Daily': 3\n","        })\n","\n","        X['Property Type'] = X['Property Type'].map({\n","            'Apartment': 0,\n","            'Condo': 1,\n","            'House': 2\n","        })\n","\n","        # 3. Date feature engineering\n","\n","        X['Policy Start Date'] = pd.to_datetime(\n","            X['Policy Start Date']\n","        ).dt.normalize()\n","\n","        X['Policy Year'] = X['Policy Start Date'].dt.year\n","        X['Policy Month'] = X['Policy Start Date'].dt.month\n","        X['Policy Day'] = X['Policy Start Date'].dt.day\n","        X['Policy DayOfWeek'] = (\n","            X['Policy Start Date'].dt.dayofweek\n","        )\n","\n","        X = X.drop(columns=['Policy Start Date'])\n","\n","        # 4. One-hot encoding with fitted training encoders\n","\n","        for col in [\n","            'Marital Status',\n","            'Occupation',\n","            'Customer Feedback'\n","        ]:\n","            encoder = self.encoders_[col]\n","\n","            encoded = encoder.transform(X[[col]])\n","\n","            encoded_df = pd.DataFrame(\n","                encoded,\n","                columns=encoder.get_feature_names_out([col]),\n","                index=X.index\n","            )\n","\n","            X = pd.concat(\n","                [X.drop(columns=[col]), encoded_df],\n","                axis=1\n","            )\n","\n","        # 5. Log transformation\n","\n","        X['Annual Income'] = np.log1p(X['Annual Income'])\n","        X['Previous Claims'] = np.log1p(X['Previous Claims'])\n","\n","        # 6. Scaling\n","\n","        scale_cols = [\n","            'Annual Income',\n","            'Previous Claims',\n","            'Health Score',\n","            'Age',\n","            'Vehicle Age',\n","            'Credit Score'\n","        ]\n","\n","        if fit_scaler:\n","            self.scaler_ = StandardScaler()\n","            X[scale_cols] = self.scaler_.fit_transform(X[scale_cols])\n","        else:\n","            X[scale_cols] = self.scaler_.transform(X[scale_cols])\n","\n","        return X\n","\n","    def transform(self, X):\n","        return self._transform(X)\n","\n","\n","preprocessing = Pipeline([\n","    ('preprocessing', CustomPreprocessor())\n","])\n"],"metadata":{"id":"XIq1WyTMN5nH","executionInfo":{"status":"ok","timestamp":1791989466244,"user_tz":240,"elapsed":21,"user":{"displayName":"Javlon Nizamiddinov","userId":"15677173226188840130"}}},"execution_count":6,"outputs":[]},{"cell_type":"markdown","source":["##Split to X and y"],"metadata":{"id":"oWd92uQiRh-Z"}},{"cell_type":"code","source":["\n","X = train_data.drop(columns=['Premium Amount', 'id'])\n","y = train_data['Premium Amount']\n","\n","\n"],"metadata":{"id":"VPjqke3fRJ8d","executionInfo":{"status":"ok","timestamp":1791989473856,"user_tz":240,"elapsed":580,"user":{"displayName":"Javlon Nizamiddinov","userId":"15677173226188840130"}}},"execution_count":7,"outputs":[]},{"cell_type":"markdown","source":["##Testing pipeline"],"metadata":{"id":"UYn2EFBRUWLN"}},{"cell_type":"code","source":["X_processed = preprocessing.fit_transform(X)\n","\n","# Check data types\n","print(X_processed.dtypes)\n","\n","# Check whether all columns are numeric\n","print('All columns numeric:',\n","      X_processed.select_dtypes(exclude='number').empty)\n","\n","# Identify any non-numeric columns\n","print('Non-numeric columns:',\n","      X_processed.select_dtypes(exclude='number').columns.tolist())"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"1ADIx5xpTv6_"